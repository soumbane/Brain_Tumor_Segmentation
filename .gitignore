# Environments
.venv/
__pycache__/
*.py[cod]

# Never commit data or derived caches. Extraction target is C:\data\brats2023,
# outside this repo, but guard against accidental copies landing here.
# NOTE: these are anchored with a leading slash on purpose. An unanchored `data/`
# matches at *any* depth and silently untracked the whole `src/brats/data/`
# package -- a clean clone or `git archive` (i.e. a Docker build context) came out
# with no data pipeline at all.
/data/
*.nii
*.nii.gz
/cache/
/runs/
/checkpoints/
*.pt
*.pth

# Cloned, not vendored
external/brats_metrics/

# Reports / artifacts are regenerated
reports/*.png
reports/*.html
reports/*.log
reports/*.err
# Large regenerable feature table (191 features x N cases)
reports/confound_features.csv

# Local tooling
.snowflake/
.ipynb_checkpoints/
.cortex

docs/
